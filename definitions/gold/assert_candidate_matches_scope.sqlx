config {
  type: "assertion",
  description: "Blocks publishing unless the candidate has exactly one row for every PUBLISHED CVE in silver.cve_latest and nothing else: no CVE lost or added by the joins, no duplicate, no REJECTED CVE, and not empty. Returns one row per problem."
}

WITH published AS (SELECT cve_id FROM ${ref("cve_latest")} WHERE state = 'PUBLISHED'),
candidate AS (SELECT cve_id FROM ${ref("cve_current_candidate")})

SELECT 'published CVE missing from the candidate' AS problem, cve_id FROM published
WHERE cve_id NOT IN (SELECT cve_id FROM candidate)
UNION ALL
SELECT 'candidate CVE that is not a published CVE in scope (e.g. REJECTED)', cve_id FROM candidate
WHERE cve_id NOT IN (SELECT cve_id FROM published)
UNION ALL
SELECT 'duplicate CVE in the candidate', cve_id FROM candidate GROUP BY cve_id HAVING COUNT(*) > 1
UNION ALL
SELECT 'candidate is empty', CAST(NULL AS STRING) FROM (SELECT COUNT(*) AS n FROM candidate) WHERE n = 0
