config {
  type: "view",
  schema: "silver",
  description: "The latest stored NVD record for each CVE, one row per CVE. Gives NIST's analysis status. A CVE missing here has no record in the NVD data we loaded.",
  columns: {
    cve_id: "CVE identifier",
    nvd_status: "NVD's vulnStatus value as returned by the NVD API (e.g. Received, Awaiting Analysis, Analyzed, Deferred)",
    nvd_published: "When NVD published its record (UTC). Can differ from CVE.org's publish date",
    nvd_last_modified: "When NVD last changed its record (UTC); used to pick the latest version",
    record_hash: "Fingerprint of the chosen NVD version; NVD's CVSS scores are joined on it",
    batch_id: "Which NVD page download brought this version",
    observed_at: "When we first had the file that contained this version (UTC)"
  },
  assertions: {
    uniqueKey: ["cve_id"],
    nonNull: ["cve_id", "nvd_status", "record_hash"]
  }
}

-- Dates from the stored source JSON (fractions of a second kept; NVD times are UTC without a zone);
-- the typed column is the fallback for older rows typed with whole seconds only
SELECT
  cve_id,
  vuln_status AS nvd_status,
  COALESCE(SAFE.TIMESTAMP(JSON_VALUE(record, '$.published')), published) AS nvd_published,
  COALESCE(SAFE.TIMESTAMP(JSON_VALUE(record, '$.lastModified')), last_modified) AS nvd_last_modified,
  record_hash,
  batch_id,
  observed_at
FROM ${ref("nvd_records")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY cve_id ORDER BY nvd_last_modified DESC, observed_at DESC, record_hash DESC) = 1
